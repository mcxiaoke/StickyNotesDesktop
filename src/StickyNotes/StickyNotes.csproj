<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>StickyNotes.Program</StartupObject>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>StickyNotes</RootNamespace>
    <AssemblyName>StickyNotes</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 应用程序视觉图标资源 -->
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Resources\App.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 核心轻量依赖 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" NoWarn="NU1701" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      语言包以「嵌入主程序集」而非 .resx 卫星程序集方式加载。
      原因：Costura.Fody 在 MSBuild 生成 *.resources.dll 之前运行，无法嵌入卫星程序集
      （Fody/Costura#61），且 PublishSingleFile 会把卫星程序集留在解压根目录导致解析失败。
      EmbeddedResource 进的是本程序集自身清单资源，Costura 不介入，单文件发布亦无影响。
    -->
    <EmbeddedResource Include="Resources\Locales\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 便携模式样例文件 -->
    <None Include="Samples\portable.sample.ini" Link="portable.sample.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>StickyNotes.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
