<ui:FluentWindow x:Class="StickyNotes.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                 Width="480" Height="680"
                 MinWidth="420" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource Fluent.WindowBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Fluent 沉浸式标题栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主内容区 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Fluent 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="设置"
                     Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                     ShowMaximize="False"
                     ShowMinimize="True" />

        <!-- 1. 设置内容滚动区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Thickness.PageMargin}">
                <!-- 顶部页面标题 (遵循 Windows 11 Fluent 设置规范) -->
                <TextBlock Text="设置"
                           Style="{StaticResource Type.TitleLarge}"
                           Margin="0,0,0,14" />

                <!-- 分组 1: 外观与字体 -->
                <TextBlock Text="外观与显示"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,0,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 字号调节行 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="便签正文字号"
                                           Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="调整便签的正文字体大小"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      Width="200"
                                      ItemsSource="{Binding FontSizeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Size"
                                      SelectedValue="{Binding SelectedFontSize, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 实时预览区 -->
                        <TextBlock Text="文字效果实时预览："
                                   Style="{StaticResource Type.CaptionSubtle}"
                                   Margin="0,0,0,6" />
                        <Border Background="{StaticResource Sticky.Yellow.BgBrush}"
                                BorderBrush="{StaticResource Sticky.Yellow.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius.Control}"
                                Padding="12,10">
                            <TextBlock Text="{Binding PreviewText}"
                                       FontSize="{Binding SelectedFontSize}"
                                       Foreground="{StaticResource Sticky.Yellow.TextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 分组 2: 窗口与系统集成 (托盘、热键、开机自启) -->
                <TextBlock Text="系统与常驻"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 1. 关闭主窗口时最小化到系统托盘 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="关闭主窗口时最小化到系统托盘" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="关闭主列表窗口后在后台保持运行，通过托盘图标可随时唤醒"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 2. 全局快捷键 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="启用系统全局快捷键" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="Win+Alt+N：快速新建便签；Win+Alt+H：打开便签列表"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding EnableGlobalHotKeys, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 3. Windows 开机自动启动 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="用户登录时自动启动应用"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 4. 开机自启时静默启动至托盘 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="启动时最小化到系统托盘" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="随系统自启时不弹出主窗口"
                                           Style="{StaticResource Type.CaptionSubtle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                             IsEnabled="{Binding IsStartMinimizedEnabled}"
                                             VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组 3: 数据备份与迁移 -->
                <TextBlock Text="数据与备份"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <TextBlock Text="JSON 备份导入与导出"
                                   Style="{StaticResource Type.SettingTitle}" />
                        <TextBlock Text="将所有便签备份为标准 JSON 文件，或从备份文件还原便签数据"
                                   Style="{StaticResource Type.CaptionSubtle}"
                                   Margin="0,3,0,12" />

                        <!-- 导出与导入按钮组 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Appearance="Primary"
                                       Content="导出便签 (JSON)"
                                       Margin="0,0,10,0"
                                       Padding="14,6"
                                       Command="{Binding ExportJsonCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Appearance="Secondary"
                                       Content="导入便签 (JSON)"
                                       Padding="14,6"
                                       Command="{Binding ImportJsonCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUpload24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 本地存储目录 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="本地数据目录"
                                               Style="{StaticResource Type.SettingTitle}" />
                                    <Border CornerRadius="4"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Margin="8,0,0,0"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeploymentModeDescription}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DataDirectoryPath}"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="提示：在 exe 同目录下放置 portable.ini 即可开启便携模式）"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           Opacity="0.8" />
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       Appearance="Secondary"
                                       Content="打开目录"
                                       Padding="12,4"
                                       Command="{Binding OpenDataFolderCommand}"
                                       VerticalAlignment="Center">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组: 网络同步（入口行，详细配置在独立窗口） -->
                <TextBlock Text="网络同步"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="多设备同步" Style="{StaticResource Type.SettingTitle}" />
                            <TextBlock Text="{Binding SyncStatusText}"
                                       Style="{StaticResource Type.CaptionSubtle}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="通过 WebDAV 或 S3 同步"
                                       Style="{StaticResource Type.CaptionSubtle}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   Content="配置…"
                                   Padding="12,5"
                                   Command="{Binding OpenSyncSettingsCommand}"
                                   VerticalAlignment="Center">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>

                <!-- 分组: 隐私保护 (PIN 锁定 + 闲时自动收起) -->
                <TextBlock Text="隐私保护"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 1. PIN 锁定 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="PIN 锁定" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="{Binding PinStatusText}"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <!-- 锁定范围声明：桌面便签不上锁是产品有意决策，必须写明，
                                     否则用户会以为贴在桌面上的正文也受保护（review 文档 676 行未决项） -->
                                <TextBlock Text="{Binding PinScopeText}"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <!-- 假安全告警：PIN 已启用但两道防线全关时必须显式提示（F-P1-6 原则） -->
                                <TextBlock Text="{Binding PinProtectionDisabledWarning}"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           Foreground="{StaticResource Fluent.DangerBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsPinProtectionDisabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <!-- PIN 数据损坏告警：绝不允许「以为受保护实则未受保护」静默发生 -->
                                <TextBlock Text="⚠ 检测到 PIN 配置数据缺失或已损坏，锁定已失效。"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           Foreground="{StaticResource Fluent.DangerBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsPinDataCorrupted, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 未启用：显示启用按钮 -->
                                <ui:Button Appearance="Primary"
                                           Content="启用 PIN"
                                           Padding="12,5"
                                           Command="{Binding EnablePinCommand}"
                                           Visibility="{Binding IsPinEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                <!-- 已启用：显示修改与清除按钮 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsPinEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ui:Button Appearance="Secondary"
                                               Content="修改 PIN"
                                               Padding="12,5"
                                               Margin="0,0,8,0"
                                               Command="{Binding ChangePinCommand}" />
                                    <ui:Button Appearance="Secondary"
                                               Content="清除 PIN"
                                               Padding="12,5"
                                               Foreground="{StaticResource Fluent.DangerBrush}"
                                               Command="{Binding ClearPinCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,0,0,10" />

                        <!-- 2. 闲置自动锁定 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="闲置自动锁定" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="无任何键鼠输入达到设定时间后，自动锁定"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      Width="215"
                                      ItemsSource="{Binding IdleLockOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Minutes"
                                      SelectedValue="{Binding SelectedIdleLockMinutes, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource Fluent.SubtleBorderBrush}" Margin="0,12,0,10" />

                        <!-- 3. 启动时锁定 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="启动时锁定" Style="{StaticResource Type.SettingTitle}" />
                                <TextBlock Text="每次启动应用都需要输入 PIN"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding LockOnLaunch, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="启动时锁定" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组 3: 关于与版本 -->
                <TextBlock Text="关于"
                           Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,8" />

                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                        Background="{StaticResource Fluent.CardBgBrush}"
                        BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                        BorderThickness="1"
                        Padding="{StaticResource Thickness.CardPadding}"
                        Margin="0,0,0,14"
                        Effect="{StaticResource Elevation.Card}">
                    <StackPanel>
                        <!-- 产品头部 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/StickyNotes;component/Assets/AppIcon.png"
                                   Width="36" Height="36"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="彩色便签"
                                           Style="{StaticResource Type.Subtitle}" />
                                <TextBlock Text="基于 Windows 11 Fluent 现代桌面便签应用"
                                           Style="{StaticResource Type.CaptionSubtle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 元数据列表 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="应用版本" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource Type.Body}" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Git 提交" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding GitCommit}" Style="{StaticResource Type.Caption}" FontFamily="Consolas" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="构建时间" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding BuildTime}" Style="{StaticResource Type.Caption}" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行环境" Style="{StaticResource Type.CaptionSubtle}" />
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeInfo}" Style="{StaticResource Type.Caption}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
