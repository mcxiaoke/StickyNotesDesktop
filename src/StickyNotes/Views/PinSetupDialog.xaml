<ui:FluentWindow x:Class="StickyNotes.Views.PinSetupDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:StickyNotes.Services.Localization"
                 Title="{loc:Loc Pin.WindowTitle, Default='PIN 锁定'}"
                 ResizeMode="NoResize"
                 Width="400" Height="380"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource Fluent.WindowBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Loc Pin.WindowTitle, Default='PIN 锁定'}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,20">

            <TextBlock x:Name="HeaderText"
                       Text="{loc:Loc Pin.Setup.SetHeader, Default='设置 PIN'}"
                       Style="{StaticResource Type.TitleLarge}"
                       Margin="0,0,0,4" />

            <TextBlock x:Name="SubHeaderText"
                       Text="{loc:Loc Pin.Setup.SetSubHeader, Default='设置后打开便签列表与归档时需输入 PIN（4~20 位，内容不限，轻量防偷窥）'}"
                       Style="{StaticResource Type.CaptionSubtle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- 当前 PIN（修改/清除模式显示） -->
            <TextBlock x:Name="CurrentPinLabel"
                       Text="{loc:Loc Pin.CurrentLabel, Default='当前 PIN'}"
                       Style="{StaticResource Type.SettingTitle}"
                       Margin="0,0,0,4" />
            <PasswordBox x:Name="CurrentPinBox"
                         Height="34"
                         FontSize="14"
                         MaxLength="20"
                         Margin="0,0,0,12" />

            <!-- 新 PIN（启用/修改模式显示） -->
            <TextBlock x:Name="NewPinLabel"
                       Text="{loc:Loc Pin.NewLabel, Default='新 PIN'}"
                       Style="{StaticResource Type.SettingTitle}"
                       Margin="0,0,0,4" />
            <PasswordBox x:Name="NewPinBox"
                         Height="34"
                         FontSize="14"
                         MaxLength="20"
                         Margin="0,0,0,12" />

            <TextBlock x:Name="ConfirmPinLabel"
                       Text="{loc:Loc Pin.ConfirmLabel, Default='确认新 PIN'}"
                       Style="{StaticResource Type.SettingTitle}"
                       Margin="0,0,0,4" />
            <PasswordBox x:Name="ConfirmPinBox"
                         Height="34"
                         FontSize="14"
                         MaxLength="20"
                         Margin="0,0,0,6" />

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource Fluent.DangerBrush}"
                       Style="{StaticResource Type.Caption}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="Collapsed" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1"
                           Content="{loc:Loc Common.Cancel, Default='取消'}"
                           Appearance="Secondary"
                           Padding="16,6"
                           Margin="0,0,8,0"
                           IsCancel="True" />

                <ui:Button Grid.Column="2"
                           Content="{loc:Loc Common.Ok, Default='确定'}"
                           Appearance="Primary"
                           Padding="16,6"
                           IsDefault="True"
                           Click="OkButton_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
