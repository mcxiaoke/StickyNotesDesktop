<ui:FluentWindow x:Class="StickyNotes.Views.NotesListWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:StickyNotes.Models"
                 xmlns:controls="clr-namespace:StickyNotes.Views.Controls"
                 xmlns:loc="clr-namespace:StickyNotes.Services.Localization"
                 Title="{loc:Loc List.WindowTitle, Default='彩色便签'}"
                 Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                 Width="480" Height="720"
                 MinWidth="380" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource Fluent.WindowBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Fluent 现代沉浸式标题栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主内容容器 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Fluent 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Loc List.WindowTitle, Default='彩色便签'}"
                     Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- 1. 主内容区 -->
        <Grid Grid.Row="1" Margin="{StaticResource Thickness.PageMargin}">
            <Grid.RowDefinitions>
                <!-- 顶部主标题与新建操作栏 -->
                <RowDefinition Height="Auto" />
                <!-- 现代全宽搜索栏 -->
                <RowDefinition Height="Auto" />
                <!-- 分类筛选胶囊与状态提示条 -->
                <RowDefinition Height="Auto" />
                <!-- 便签卡片流或搜索结果展示区 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1.1 顶部标题与新建操作栏 -->
            <Grid Grid.Row="0" Margin="{StaticResource Thickness.HeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧品牌与标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/StickyNotes;component/Assets/AppIcon.png"
                           Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc List.Heading, Default='便签'}"
                               Style="{StaticResource Type.TitleLarge}" />
                </StackPanel>

                <!-- 右侧操作群：立即同步、已归档、设置、新建（高度统一 32px） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 手动立即同步按钮（协议设计 §6 触发时机 5） -->
                    <ui:Button x:Name="SyncNowButton"
                               Appearance="Secondary"
                               Content="{loc:Loc Sync.Now, Default='立即同步'}"
                               Height="32"
                               Padding="10,0"
                               ToolTip="{loc:Loc Sync.NowTooltip, Default='立即与云端同步一次'}"
                               Margin="0,0,6,0"
                               Click="SyncNowButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- 已归档入口按钮 -->
                    <ui:Button Appearance="Secondary"
                               Content="{loc:Loc List.Archived, Default='已归档'}"
                               Height="32"
                               Padding="10,0"
                               ToolTip="{loc:Loc List.ArchivedTooltip, Default='查看已归档便签'}"
                               Margin="0,0,6,0"
                               Click="OpenArchiveButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Archive24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- 设置入口按钮 -->
                    <ui:Button Appearance="Secondary"
                               Content="{loc:Loc Common.Settings, Default='设置'}"
                               Height="32"
                               Padding="10,0"
                               ToolTip="{loc:Loc Common.SettingsTooltip, Default='设置'}"
                               Margin="0,0,6,0"
                               Click="OpenSettingsButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- 新建便签按钮 (Windows 11 Accent 胶囊) -->
                    <ui:Button Appearance="Primary"
                               Content="{loc:Loc Tray.NewNote, Default='新建'}"
                               Height="32"
                               Padding="12,0"
                               ToolTip="{loc:Loc List.NewTooltip, Default='新建一张便签 (Ctrl+N)'}"
                               Command="{Binding NewNoteCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>



            <!-- 1.2 现代 Fluent 搜索栏 -->
            <ui:TextBox x:Name="SearchBox"
                        Grid.Row="1"
                        PlaceholderText="{loc:Loc List.SearchPlaceholder, Default='搜索便签内容... (Ctrl+F)'}"
                        ClearButtonEnabled="True"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="13"
                        Margin="0,0,0,10"
                        PreviewKeyDown="SearchBox_PreviewKeyDown">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!-- 1.3 分类筛选与状态信息栏 -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <!-- 非搜索状态：显示现代分段导航 Segmented Tabs 与右侧提示 -->
                <Grid Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Windows 11 标准分段标签容器 -->
                    <Border Background="#09000000" CornerRadius="6" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAllRadio"
                                         Style="{StaticResource FilterChipStyle}"
                                         GroupName="NoteFilterGroup"
                                         IsChecked="True"
                                         Checked="FilterAllRadio_Checked">
                                <TextBlock>
                                    <Run Text="{loc:Loc Filter.All, Default='全部'}" />
                                    <Run Text=" (" /><Run Text="{Binding Notes.Count, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </RadioButton>

                            <RadioButton x:Name="FilterPinnedRadio"
                                         Style="{StaticResource FilterChipStyle}"
                                         GroupName="NoteFilterGroup"
                                         Margin="2,0,0,0"
                                         Checked="FilterPinnedRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pin16" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{loc:Loc Filter.Pinned, Default='已置顶'}" />
                                        <Run Text=" (" /><Run Text="{Binding PinnedNotesCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- 右侧辅助提示 -->
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Type.CaptionSubtle}"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{loc:Loc List.DoubleClickHint, Default='双击卡片打开'}" />
                </Grid>

                <!-- 搜索状态：显示命中统计提示（卡片数与便签数分离，扁平多卡片时明确来源） -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource Fluent.AccentBrush}" />
                    <TextBlock Style="{StaticResource Type.Caption}"
                               Foreground="{StaticResource Fluent.AccentBrush}"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{Binding SearchStatusText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- 1.4 主卡片流列表 -->
            <Grid Grid.Row="3">
                <!-- 普通列表模式：一体化通体原色 Fluent 便签卡片流 (支持全键盘上下/翻页/顶底导航) -->
                <ListBox x:Name="NotesListBox"
                         ItemsSource="{Binding FilteredNotes}"
                         FocusVisualStyle="{x:Null}"
                         IsTabStop="False"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                         GotKeyboardFocus="ListBox_GotKeyboardFocus"
                         PreviewKeyDown="NotesListBox_PreviewKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Note}">
                                    <!-- 一体化高雅卡片：通体原色融合，自适应 1~4 行纯文本 -->
                                    <Border CornerRadius="{StaticResource CornerRadius.Card}"
                                            Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
                                            BorderBrush="{Binding Color, Converter={StaticResource NoteColorToBorderConverter}}"
                                            BorderThickness="1"
                                            Padding="{StaticResource Thickness.CardPadding}"
                                            MouseLeftButtonDown="NoteCard_MouseLeftButtonDown"
                                            MouseRightButtonDown="NoteCard_MouseRightButtonDown">
                                        <!-- 鼠标滑过平滑柔和光影与键盘选中轮廓 -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- 固定效果单例，禁止在 Trigger 内联重建（原 F-P2-22） -->
                                                <Setter Property="Effect" Value="{StaticResource Elevation.CardSubtle}" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Effect" Value="{StaticResource Elevation.CardHoverLight}" />
                                                    </MultiDataTrigger>
                                                    <!-- 键盘或鼠标选中：Windows 11 Fluent 2px 强调色聚焦轮廓 -->
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Fluent.AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Effect" Value="{StaticResource Elevation.CardFocus}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Loc Context.OpenNote, Default='打开便签'}" Click="ContextOpenNote_Click">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Open20" FontSize="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{loc:Loc Context.TogglePin, Default='切换列表置顶'}" Click="ContextTogglePin_Click">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Pin20" FontSize="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{loc:Loc Context.ArchiveNote, Default='归档便签'}" Click="ContextDeleteNote_Click" Foreground="{StaticResource Fluent.DangerBrush}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Archive20" FontSize="16" Foreground="{StaticResource Fluent.DangerBrush}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <!-- 卡片内容区：自然舒展排版 -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- 纯文本内容与操作栏 -->
                                                <RowDefinition Height="*" />
                                                <!-- 底部信息 -->
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 上部：纯文本（统一字体不加粗，自适应 1~4 行）与右上角操作区 -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 纯文本正文：按需显示，最小一行，最多4行 -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PreviewText}"
                                                           Style="{StaticResource Type.Body}"
                                                           FontWeight="Normal"
                                                           FontSize="13"
                                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           LineHeight="20"
                                                           MaxHeight="80"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,8,0" />

                                                <!-- 右侧图钉与更多操作 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <ui:SymbolIcon Symbol="Pin20"
                                                                   FontSize="13"
                                                                   Margin="0,3,4,0"
                                                                   VerticalAlignment="Top"
                                                                   Foreground="{Binding Color, Converter={StaticResource NoteColorToAccentConverter}}"
                                                                   Visibility="{Binding IsPinnedInList, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Button Style="{StaticResource StickyToolbarButtonStyle}"
                                                            ToolTip="{loc:Loc Context.NoteActions, Default='便签操作'}"
                                                            AutomationProperties.Name="{loc:Loc Context.NoteActions, Default='便签操作'}"
                                                            Click="CardMoreButton_Click">
                                                        <ui:SymbolIcon Symbol="MoreHorizontal20"
                                                                       FontSize="14"
                                                                       Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 底部时间戳与状态信息 -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 字符统计微标签 -->
                                                <TextBlock Grid.Column="0"
                                                           Style="{StaticResource Type.CaptionSubtle}"
                                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding Content.Length, Mode=OneWay}" /><Run Text="{loc:Loc List.CharUnit, Default=' 字符'}" />
                                                </TextBlock>

                                                <!-- 友好更新时间 -->
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource Type.CaptionSubtle}"
                                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding UpdatedAt, Converter={StaticResource FriendlyDateTimeConverter}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                <!-- 空状态引导视图：绝对居中于列表区 -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="{Binding HasNoNotes}"
                            Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Note24" FontSize="48" Foreground="{StaticResource Fluent.TextTertiaryBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="{loc:Loc List.EmptyTitle, Default='还没有任何便签'}"
                               Style="{StaticResource Type.Subtitle}"
                               Foreground="{StaticResource Fluent.TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Loc List.EmptySubtitle, Default='点击上方“新建便签”随时记录你的灵感与任务'}"
                               Style="{StaticResource Type.Caption}"
                               Foreground="{StaticResource Fluent.TextTertiaryBrush}"
                               Margin="0,6,0,16"
                               HorizontalAlignment="Center" />
                    <ui:Button Appearance="Secondary"
                               Icon="Add24"
                               Content="{loc:Loc List.EmptyAction, Default='立即创建第一张便签'}"
                               HorizontalAlignment="Center"
                               Command="{Binding NewNoteCommand}" />
                </StackPanel>

                <!-- 搜索模式视图：精准跳行与清晰命中 (支持全键盘上下/翻页/顶底导航) -->
                <Grid Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="SearchHitsListBox"
                             ItemsSource="{Binding SearchResults}"
                             FocusVisualStyle="{x:Null}"
                             IsTabStop="False"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             GotKeyboardFocus="ListBox_GotKeyboardFocus"
                             PreviewKeyDown="SearchHitsListBox_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SearchHit}">
                                <Border CornerRadius="{StaticResource CornerRadius.Card}"
                                        Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
                                        BorderBrush="{Binding Color, Converter={StaticResource NoteColorToBorderConverter}}"
                                        BorderThickness="1"
                                        Padding="{StaticResource Thickness.SearchHitPadding}"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="SearchHitCard_PreviewMouseLeftButtonDown"
                                        MouseLeftButtonUp="SearchHitCard_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- 固定效果单例，禁止在 Trigger 内联重建（原 F-P2-22） -->
                                            <Setter Property="Effect" Value="{StaticResource Elevation.CardSubtle}" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Effect" Value="{StaticResource Elevation.CardHoverLight}" />
                                                </MultiDataTrigger>
                                                <!-- 键盘或鼠标选中：Windows 11 Fluent 2px 强调色聚焦轮廓 -->
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Fluent.AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Effect" Value="{StaticResource Elevation.CardFocus}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 便签所属色标、标题与第 N 行指示器 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NoteTitle}"
                                                           Style="{StaticResource Type.Subtitle}"
                                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 右侧：更新时间与行号胶囊 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource FriendlyDateTimeConverter}}"
                                                           Style="{StaticResource Type.CaptionSubtle}"
                                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{Binding Color, Converter={StaticResource NoteColorToToolbarConverter}}"
                                                        BorderBrush="{Binding Color, Converter={StaticResource NoteColorToBorderConverter}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource CornerRadius.Small}"
                                                        Padding="6,2">
                                                    <TextBlock Style="{StaticResource Type.CaptionSubtle}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                                                               Text="{Binding BadgeText, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 1~3 行智能上下文行预览 (支持关键词高亮) -->
                                        <Border Grid.Row="1"
                                                Background="#08000000"
                                                CornerRadius="{StaticResource CornerRadius.Small}"
                                                Padding="10,8"
                                                Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:SnippetLine}">
                                                        <ItemsControl ItemsSource="{Binding Segments}" Margin="0,1">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:SnippetSegment}">
                                                                    <Border CornerRadius="3"
                                                                            Padding="2,0"
                                                                            Margin="0,0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="Transparent" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsHit}" Value="True">
                                                                                        <Setter Property="Background" Value="#FFFDE047" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding Text}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="FontSize" Value="13" />
                                                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                                                    <Setter Property="Foreground" Value="{Binding DataContext.Color, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource NoteColorToTextConverter}}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsHit}" Value="True">
                                                                                            <Setter Property="Foreground" Value="#FF1F2937" />
                                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 搜索无结果提示 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,80,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchHitCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="Search24" FontSize="44" Foreground="{StaticResource Fluent.TextTertiaryBrush}" Margin="0,0,0,10" />
                            <TextBlock Text="{loc:Loc Search.EmptyTitle, Default='未找到匹配的便签'}"
                                       Style="{StaticResource Type.Subtitle}"
                                       Foreground="{StaticResource Fluent.TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Search.EmptySubtitle, Default='请尝试更换关键字或检查拼写'}"
                                       Style="{StaticResource Type.Caption}"
                                       Foreground="{StaticResource Fluent.TextTertiaryBrush}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
            </Grid>
        </Grid>
        <!-- 非打断式轻提示条：替代此前同步结果一律弹 MessageBox 的做法。
         放在 PIN 遮罩之前，使提示在锁定态下依然可见；IsOpen 默认关闭，不占布局。 -->
        <ui:InfoBar x:Name="SyncInfoBar"
                    Grid.Row="1"
                    Margin="16,0,16,12"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False" />
        <!-- 1. PIN 锁定遮罩：盖住内容区（保留标题栏可拖动/关闭），锁定时完全遮挡便签内容 -->
        <controls:PinLockOverlay x:Name="PinOverlay"
                                 Grid.Row="1" />
    </Grid>
</ui:FluentWindow>

