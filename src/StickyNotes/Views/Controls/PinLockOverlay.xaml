<UserControl x:Class="StickyNotes.Views.Controls.PinLockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:StickyNotes.Services.Localization"
             IsHitTestVisible="True"
             Focusable="False">

    <!-- 不透明遮罩根：完全盖住宿主窗口内容区，防止底层内容以任何形式透视 -->
    <Grid x:Name="RootGrid"
          Background="{StaticResource Fluent.WindowBgBrush}"
          Visibility="Collapsed">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    x:Name="InputPanel">

            <ui:SymbolIcon Symbol="LockClosed24"
                           FontSize="44"
                           Foreground="{StaticResource Fluent.AccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

            <TextBlock Text="{loc:Loc Pin.LockedTitle, Default='内容已锁定'}"
                       Style="{StaticResource Type.Subtitle}"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="HintText"
                       Text="{loc:Loc Pin.HintDefault, Default='输入 PIN 后按 Enter 解锁'}"
                       Style="{StaticResource Type.CaptionSubtle}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,20" />

            <PasswordBox x:Name="PinBox"
                         Width="240"
                         Height="34"
                         FontSize="15"
                         MaxLength="20"
                         PasswordChar="●"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="{loc:Loc Pin.BoxName, Default='PIN 密码输入框'}"
                         KeyDown="PinBox_KeyDown" />

            <!-- 错误提示：验证失败时显示 -->
            <TextBlock x:Name="ErrorText"
                       Text="{loc:Loc Pin.Incorrect, Default='PIN 不正确，请重试'}"
                       Foreground="{StaticResource Fluent.DangerBrush}"
                       Style="{StaticResource Type.Caption}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />

            <!-- 忘记 PIN 指引（轻量防护定位，不做应用内找回）。
                 用 Button 而非纯 TextBlock：键盘用户可 Tab 聚焦、Enter 触发（F-P1-11 剩余项） -->
            <Button HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    AutomationProperties.Name="{loc:Loc Pin.ForgotName, Default='忘记 PIN 怎么办'}"
                    Click="ForgotPin_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{loc:Loc Pin.Forgot, Default='忘记 PIN？'}"
                                   Style="{StaticResource Type.CaptionSubtle}"
                                   Foreground="{StaticResource Fluent.AccentBrush}"
                                   Cursor="Hand">
                            <TextBlock.TextDecorations>
                                <TextDecorationCollection>
                                    <TextDecoration Location="Underline" />
                                </TextDecorationCollection>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
