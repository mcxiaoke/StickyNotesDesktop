<Window x:Class="StickyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:StickyNotes.Models"
        xmlns:loc="clr-namespace:StickyNotes.Services.Localization"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/StickyNotes;component/Assets/AppIcon.ico"
        Width="380" Height="420"
        MinWidth="280" MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}"
        Topmost="{Binding AlwaysOnTop}"
        PreviewMouseWheel="NoteWindow_PreviewMouseWheel">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 主便签容器：硬件加速渲染，1px 原色精致边框 -->
    <Border BorderBrush="{Binding Color, Converter={StaticResource NoteColorToBorderConverter}}"
            BorderThickness="1"
            Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}">

        <Grid Background="{Binding Color, Converter={StaticResource NoteColorToBgConverter}}">
            <Grid.RowDefinitions>
                <!-- 顶部无缝工具栏 -->
                <RowDefinition Height="34" />
                <!-- 正文编辑区（占满剩余高度） -->
                <RowDefinition Height="*" />
                <!-- 底部微型辅助栏 -->
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部工具栏：一体化原色微调，全区域支持按住拖拽 -->
            <Border Grid.Row="0"
                    CornerRadius="7,7,0,0"
                    Background="{Binding Color, Converter={StaticResource NoteColorToToolbarConverter}}"
                    MouseLeftButtonDown="Toolbar_MouseLeftButtonDown"
                    Padding="6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 左侧：新建按钮 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 中间：拖拽区域 -->
                        <ColumnDefinition Width="*" />
                        <!-- 右侧：置顶、更多菜单、关闭 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 新建便签按钮 -->
                    <Button Grid.Column="0"
                            Style="{StaticResource StickyToolbarButtonStyle}"
                            ToolTip="{loc:Loc Note.NewTooltip, Default='新建便签 (Ctrl+N)'}"
                            AutomationProperties.Name="{loc:Loc Note.NewName, Default='新建便签'}"
                            Click="NewNoteButton_Click">
                        <ui:SymbolIcon Symbol="Add20" FontSize="16" Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                    </Button>

                    <!-- 中间拖拽标题占位（透明贯穿）：显示便签首行摘要，
                         使任务栏缩略图（Windows 取窗口实时渲染）天然带有可辨识文字 -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="8,0"
                               Text="{Binding WindowTitle}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               Opacity="0.85"
                               Foreground="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}"
                               ToolTip="{Binding WindowTitle}" />

                    <!-- 右侧按钮操作群 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 桌面置顶图钉切换按钮 -->
                        <Button Style="{StaticResource StickyToolbarButtonStyle}"
                                ToolTip="{loc:Loc Note.PinTooltip, Default='桌面置顶 (Ctrl+P)'}"
                                AutomationProperties.Name="{loc:Loc Note.PinName, Default='桌面置顶'}"
                                Margin="0,0,2,0"
                                Command="{Binding TogglePinCommand}">
                            <Grid>
                                <!-- 置顶高亮底衬 -->
                                <Border x:Name="PinnedHighlight" Width="26" Height="26"
                                        CornerRadius="{StaticResource CornerRadius.Small}"
                                        Background="#26000000"
                                        Visibility="{Binding AlwaysOnTop, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ui:SymbolIcon Symbol="Pin20" FontSize="15"
                                               Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                            </Grid>
                        </Button>

                        <!-- 微软 Sticky Notes 原汁原味的 ··· 更多菜单 -->
                        <Button x:Name="MoreMenuButton"
                                Style="{StaticResource StickyToolbarButtonStyle}"
                                ToolTip="{loc:Loc Note.MoreTooltip, Default='便签设置与颜色'}"
                                AutomationProperties.Name="{loc:Loc Note.MoreName, Default='便签设置与颜色'}"
                                Margin="0,0,2,0"
                                Click="MoreMenuButton_Click">
                            <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="15"
                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                        </Button>

                        <!-- 更多菜单弹出层：包含 7 种主题色彩圆点与操作项 -->
                        <Popup x:Name="MoreMenuPopup"
                               PlacementTarget="{Binding ElementName=MoreMenuButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="#FFFFFFFF"
                                    BorderBrush="{StaticResource Fluent.SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadius.Card}"
                                    Padding="8,8"
                                    Margin="4"
                                    Effect="{StaticResource Elevation.Popup}">

                                <StackPanel Width="224">
                                    <!-- 顶部提示 (规范次要字阶，不加粗) -->
                                    <TextBlock Text="{loc:Loc Note.ThemeColors, Default='便签主题色彩'}"
                                               Style="{StaticResource Type.Caption}"
                                               Foreground="{StaticResource Fluent.TextSecondaryBrush}"
                                               Margin="4,2,0,8" />

                                    <!-- 7 色精美调色盘：带当前选中 Checkmark 勾选反馈 -->
                                    <WrapPanel HorizontalAlignment="Center">
                                        <!-- 1. 经典黄 -->
                                        <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Yellow.BgBrush}" BorderBrush="{StaticResource Sticky.Yellow.BorderBrush}" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Yellow}" ToolTip="{loc:Loc Note.Color.Yellow, Default='经典黄'}" AutomationProperties.Name="{loc:Loc Note.ColorAccessible.Yellow, Default='便签颜色：经典黄'}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{StaticResource Sticky.Yellow.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Color, Converter={StaticResource NoteColorEqualsConverter}, ConverterParameter='Yellow'}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 2. 清新绿 -->
                                        <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Green.BgBrush}" BorderBrush="{StaticResource Sticky.Green.BorderBrush}" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Green}" ToolTip="{loc:Loc Note.Color.Green, Default='清新绿'}" AutomationProperties.Name="{loc:Loc Note.ColorAccessible.Green, Default='便签颜色：清新绿'}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{StaticResource Sticky.Green.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Color, Converter={StaticResource NoteColorEqualsConverter}, ConverterParameter='Green'}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 3. 柔和粉 -->
                                        <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Pink.BgBrush}" BorderBrush="{StaticResource Sticky.Pink.BorderBrush}" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Pink}" ToolTip="{loc:Loc Note.Color.Pink, Default='柔和粉'}" AutomationProperties.Name="{loc:Loc Note.ColorAccessible.Pink, Default='便签颜色：柔和粉'}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{StaticResource Sticky.Pink.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Color, Converter={StaticResource NoteColorEqualsConverter}, ConverterParameter='Pink'}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 4. 梦幻紫 -->
                                        <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Purple.BgBrush}" BorderBrush="{StaticResource Sticky.Purple.BorderBrush}" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Purple}" ToolTip="{loc:Loc Note.Color.Purple, Default='梦幻紫'}" AutomationProperties.Name="{loc:Loc Note.ColorAccessible.Purple, Default='便签颜色：梦幻紫'}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{StaticResource Sticky.Purple.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Color, Converter={StaticResource NoteColorEqualsConverter}, ConverterParameter='Purple'}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 5. 天空蓝 -->
                                        <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Blue.BgBrush}" BorderBrush="{StaticResource Sticky.Blue.BorderBrush}" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Blue}" ToolTip="{loc:Loc Note.Color.Blue, Default='天空蓝'}" AutomationProperties.Name="{loc:Loc Note.ColorAccessible.Blue, Default='便签颜色：天空蓝'}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{StaticResource Sticky.Blue.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Color, Converter={StaticResource NoteColorEqualsConverter}, ConverterParameter='Blue'}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 6. 浅灰白 -->
                                        <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Gray.BgBrush}" BorderBrush="{StaticResource Sticky.Gray.BorderBrush}" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Gray}" ToolTip="{loc:Loc Note.Color.Gray, Default='浅灰白'}" AutomationProperties.Name="{loc:Loc Note.ColorAccessible.Gray, Default='便签颜色：浅灰白'}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{StaticResource Sticky.Gray.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Color, Converter={StaticResource NoteColorEqualsConverter}, ConverterParameter='Gray'}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 7. 暗黑夜间 -->
                                        <Button Width="26" Height="26" Margin="2" Background="{StaticResource Sticky.Charcoal.BgBrush}" BorderBrush="{StaticResource Sticky.Charcoal.BorderBrush}" BorderThickness="1" Click="ColorSelected_Click" Tag="{x:Static models:NoteColor.Charcoal}" ToolTip="{loc:Loc Note.Color.Charcoal, Default='暗黑夜间'}" AutomationProperties.Name="{loc:Loc Note.ColorAccessible.Charcoal, Default='便签颜色：暗黑夜间'}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{StaticResource Sticky.Charcoal.TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Color, Converter={StaticResource NoteColorEqualsConverter}, ConverterParameter='Charcoal'}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </WrapPanel>

                                    <Separator Margin="0,8,0,6" Background="{StaticResource Fluent.SubtleBorderBrush}" />

                                    <!-- 快捷跳转：便签列表 (标准 Windows 11 Fluent 菜单项交互) -->
                                    <Button Style="{StaticResource FluentFlyoutMenuItemStyle}"
                                            Click="ShowNotesList_Click"
                                            ToolTip="{loc:Loc Note.OpenListTooltip, Default='打开便签管理中心'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="AppsListDetail20" FontSize="15" Foreground="{StaticResource Fluent.TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{loc:Loc Note.OpenList, Default='便签列表'}" Style="{StaticResource Type.Body}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="Ctrl+H" Style="{StaticResource Type.CaptionSubtle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <!-- 归档便签 (危险操作项：统一标准整行菜单) -->
                                    <Button Style="{StaticResource FluentFlyoutDangerMenuItemStyle}"
                                            Click="DeleteButton_Click"
                                            ToolTip="{loc:Loc Note.ArchiveTooltip, Default='归档此便签'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Archive20" FontSize="15" Foreground="{StaticResource Fluent.DangerBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{loc:Loc Note.Archive, Default='归档便签'}" Style="{StaticResource Type.Body}" Foreground="{StaticResource Fluent.DangerBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="Ctrl+D" Style="{StaticResource Type.CaptionSubtle}" TextWrapping="NoWrap" Foreground="{StaticResource Fluent.DangerBrush}" Opacity="0.8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- 关闭按钮（收起贴纸窗口） -->
                        <Button x:Name="CloseNoteButton"
                                Style="{StaticResource StickyCloseButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{loc:Loc Note.CloseTooltip, Default='关闭便签 (Ctrl+W)'}"
                                AutomationProperties.Name="{loc:Loc Note.CloseName, Default='关闭便签'}"
                                Click="CloseButton_Click">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="15"
                                           Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 正文编辑区：使用定制的 StickyEditorTextBoxStyle，彻底透明绝不变白 -->
            <TextBox x:Name="EditorTextBox"
                     Grid.Row="1"
                     Style="{StaticResource StickyEditorTextBoxStyle}"
                     Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                     CaretBrush="{Binding Color, Converter={StaticResource NoteColorToTextConverter}}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     IsInactiveSelectionHighlightEnabled="True"
                     SelectionBrush="#3399FF"
                     FontSize="{Binding FontSize}"
                     FontFamily="{StaticResource FontFamily.Default}"
                     Padding="{StaticResource Thickness.StickyEditorPadding}" />


            <!-- 3. 底部微型辅助栏：统计字符数与已同步状态 -->
            <Grid Grid.Row="2" Margin="{StaticResource Thickness.StickyFooterMargin}" VerticalAlignment="Center">
                <!-- 实时字数与状态提示 -->
                <TextBlock Style="{StaticResource Type.CaptionSubtle}"
                           Foreground="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding Content.Length, Mode=OneWay}" /><Run Text="{loc:Loc Note.CharUnit, Default=' 字符'}" />
                </TextBlock>

                <!-- 真实自动保存状态：与 NoteViewModel.SaveState 严格对应（保存中 / 已同步 HH:mm:ss / 保存失败可点击重试） -->
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,0"
                        Command="{Binding RetrySaveCommand}"
                        AutomationProperties.Name="{loc:Loc Note.SaveStateName, Default='自动保存状态，保存失败时可点击重试'}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <!-- 仅在失败态可点击重试，其余状态不可交互 -->
                                <DataTrigger Binding="{Binding SaveState}" Value="Failed">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SaveState}" Value="Saved">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SaveState}" Value="Pending">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Text="{Binding SaveStatusText, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Type.CaptionSubtle}">
                                <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource NoteColorToSecondaryTextConverter}}" />
                                <Style.Triggers>
                                    <!-- 保存失败时必须使用危险色突出显示，避免用户误以为已落盘 -->
                                    <DataTrigger Binding="{Binding SaveState}" Value="Failed">
                                        <Setter Property="Foreground" Value="{StaticResource Fluent.DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

